# 비우면 파일 기반 PGlite(./.data/pglite)를 쓴다. 운영/시범은 PostgreSQL(Supabase 포함) 주소를 넣는다.
DATABASE_URL=

# 운영(production)에서는 필수. 세션 쿠키 서명용 임의 문자열
SESSION_SECRET=

# 문자 링크에 들어갈 서비스 주소 (휴대폰에서 열 수 있는 주소여야 함)
APP_BASE_URL=http://localhost:3000

# 개발용 사용자 선택 로그인. SSO 연동 후 false
ALLOW_DEV_LOGIN=true
# 데모 조직·보고실 데이터 자동 생성
SEED_DEMO=true

# 문자 발송: console(서버 로그 출력, 개발용) | solapi(실제 발송)
MESSAGING_PROVIDER=console
# 솔라피 콘솔 > API Key 관리. 절대 커밋하지 말고 .env.local에만 둔다.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
# 솔라피에 등록·인증된 발신번호 (예: 구청 대표번호)
SOLAPI_SENDER=
# 솔라피 메시지 리포트 웹훅 비밀값: https://<서버>/api/webhooks/messaging?secret=<값>
MESSAGING_WEBHOOK_SECRET=
