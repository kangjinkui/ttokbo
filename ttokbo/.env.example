# 비우면 파일 기반 PGlite(./.data/pglite)를 쓴다. 운영/시범은 PostgreSQL(Supabase 포함) 주소를 넣는다.
DATABASE_URL=

# 운영(production)에서는 필수. 세션 쿠키 서명용 임의 문자열
SESSION_SECRET=

# 알림톡 버튼 링크에 들어갈 서비스 주소
APP_BASE_URL=http://localhost:3000

# 개발용 사용자 선택 로그인. SSO 연동 후 false
ALLOW_DEV_LOGIN=true
# 데모 조직·보고실 데이터 자동 생성
SEED_DEMO=true

# 알림톡 발송 대행사 어댑터. 계약 전에는 console(서버 로그 출력)
MESSAGING_PROVIDER=console
# console 어댑터에서 SMS 대체발송을 흉내 낼 때 1
MOCK_KAKAO_FAIL=
# 대행사 결과 웹훅(/api/webhooks/messaging) 공유 비밀값 (x-ttokbo-secret 헤더)
MESSAGING_WEBHOOK_SECRET=

# 카카오 검수 완료된 알림톡 템플릿 코드
KAKAO_TPL_PREPARE=TTOKBO_PREPARE
KAKAO_TPL_IMMINENT=TTOKBO_IMMINENT
KAKAO_TPL_CALL=TTOKBO_CALL
KAKAO_TPL_CHANGE=TTOKBO_CHANGE
